6. Crear updateGarantia()

Debajo de updatePrecio():

function updateGarantia(idx, value) {
    quoteItems[idx].garantia = value;

    const input = document.querySelector(
        `input[name="items[${idx}][garantia]"]`
    );

    if (input) {
        input.value = value ? 1 : 0;
    }
}

No necesitamos volver a renderizar toda la tabla cuando se cambia el checkbox.


